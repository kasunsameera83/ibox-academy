# Copy this file to .env.local and fill in the values.
# NEXT_PUBLIC_* values are sent to the browser — never put secrets in them.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only secrets. Never prefix with NEXT_PUBLIC_.
# Supabase → Project Settings → API Keys → Secret key. Server-only: PayHere webhook, staff invites, audit log.
SUPABASE_SECRET_KEY=

# PayHere → Settings → Domains & Credentials (sandbox first). PAYHERE_MODE = sandbox | live
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_MODE=sandbox

# Bunny Stream (Stream → your library → API / Security). Server-only.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=

# App emails (welcome, payment received, support replies, certificates).
# Same mailbox as Supabase SMTP. Server-only: never prefix with NEXT_PUBLIC_.
SMTP_HOST=server.cloudmail.lk
SMTP_PORT=465
SMTP_USER=hello@iboxacademy.com
SMTP_PASSWORD=
EMAIL_FROM="iBox Academy <hello@iboxacademy.com>"
